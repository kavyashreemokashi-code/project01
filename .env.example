# CivicAI Environment Configuration
# Optional: Google Gemini API key for external LLM enhancement.
# If omitted or empty, CivicAI uses its built-in Python NLP & mathematical TF-IDF engine.
GEMINI_API_KEY=

# Database configuration (defaults to SQLite in backend directory)
DATABASE_URL=sqlite:///./civicai.db

# Demo Admin Credentials
DEMO_ADMIN_USER=admin@civicai.gov
DEMO_ADMIN_PASSWORD=admin123
DEMO_TOKEN=civicai-admin-demo-token-xyz

# Upload Storage Directory
UPLOAD_DIR=./uploads
